rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Profiles: anyone can read, authenticated users can create, owner can update/delete
    match /profiles/{username} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;

      // Pages subcollection
      match /pages/{pageId} {
        allow read: if true;
        allow write: if request.auth != null
          && get(/databases/$(database)/documents/profiles/$(username)).data.uid == request.auth.uid;

        // Blocks subcollection
        match /blocks/{blockId} {
          allow read: if true;
          allow write: if request.auth != null
            && get(/databases/$(database)/documents/profiles/$(username)).data.uid == request.auth.uid;
        }
      }
    }

    // Wallet reverse lookup: any authenticated user can create, owner can update
    match /wallets/{walletAddress} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // User favorites: only the owner can read/write their favorites
    match /users/{uid}/favorites/{docId} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid;
    }
  }
}
